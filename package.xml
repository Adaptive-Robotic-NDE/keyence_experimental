<?xml version="1.0"?>
<!-- <package format="2"> -->
<package format="3">
  <name>keyence_experimental</name>
  <version>0.1.0</version>
  <description>Keyence driver for laser line scanners</description>

  <maintainer email="jonathan.meyer@swri.org">Jonathan Meyer</maintainer>

  <license>Apache 2.0</license>

  <url type="website">https://github.com/ros-industrial/keyence_experimental</url>

  <author email="jonathan.meyer@swri.org">Jonathan Meyer</author>
  <author email="g.a.vanderhoorn@tudelft.nl">G.A. vd. Hoorn (TU Delft Robotics Institute)</author>
  <author email="West_Matthew_T@cat.com">Matthew West</author>
  
  <!-- <buildtool_depend>catkin</buildtool_depend> -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- <depend>message_generation</depend> -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- <depend>message_runtime</depend> -->
  <depend>sensor_msgs</depend>
  <depend>pcl_ros</depend>
  <!-- <depend>roscpp</depend> -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <!-- Included by the sources, and needed here so colcon orders the build
       against them:
         keyence_driver_node.cpp     -> std_msgs, pcl_conversions
         point_cloud_reconstruction.cpp -> visualization_msgs, pcl_conversions
       CMakeLists.txt find_package()s all of these. -->
  <depend>std_msgs</depend>
  <!-- keyence_driver_node publishes a DiagnosticArray on `keyence_status`, so
       that a silent /profiles can be told from a dead driver: a controller
       whose laser is off answers every request and attaches no profile, and
       from outside that is indistinguishable from a dead node. -->
  <depend>diagnostic_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>visualization_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>libboost-dev</depend>
  <!-- <depend>keyence_interfaces</depend> -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <!-- REQUIRED, and it is a package in the same colcon workspace.
       CMakeLists.txt does find_package(libsocket REQUIRED); with this
       commented out colcon does not know the two are related, so it does
       not order the build and does not put libsocket on CMAKE_PREFIX_PATH.
       A clean build then fails with
       "Add the installation prefix of libsocket to CMAKE_PREFIX_PATH", while
       an incremental build in an already-populated workspace succeeds, so the
       fault appears only on a build from scratch. -->
  <depend>libsocket</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
